{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "JwtSettings": {
    "Issuer": "OrderPaymentSystem",
    "Audience": "OrderPaymentSystem",
    "Authority": "OrderPaymentSystem",
    "Lifetime": 15,
    "RefreshTokenValidityInDays": 7,
    "AccessTokenValidityInMinutes": 10
  },
  "RedisSettings": {
    "InstanceName": "OrderPaymentSystem:Local:"
  },
  "AllowedHosts": "*",
  "RateLimitSettings": {
    "Enabled": true,
    "MaxRequests": 100,
    "WindowSizeInSeconds": 60,
    "DifferentLimitsForAuth": false,
    "ExcludedPaths": [
      "/health",
      "/health/ready",
      "/health/live",
      "/metrics",
      "/swagger"
    ]
  },
  "Resilience": {
    "Cache": {
      "RetryCount": 2,
      "RetryDelaySeconds": 0.5,
      "TimeoutSeconds": 5.0
    },
    "Database": {
      "RetryCount": 3,
      "RetryDelaySeconds": 1.0,
      "FailureRatio": 0.5,
      "MinimumThroughput": 10,
      "SamplingDurationSeconds": 30.0,
      "BreakDurationSeconds": 30.0
    },
    "HttpClient": {
      "RetryCount": 3,
      "RetryDelaySeconds": 1.0,
      "FailureRatio": 0.5,
      "MinimumThroughput": 10,
      "SamplingDurationSeconds": 30.0,
      "BreakDurationSeconds": 30.0,
      "TimeoutSeconds": 30.0
    }
  }
}